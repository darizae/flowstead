# Flowstead local/staging runtime configuration.
#
# DATABASE_URL and the SUPABASE_* verifier settings are SERVER-ONLY: keep them
# in the host secret store, never in a browser bundle. The frontend build takes
# only the publishable values from frontend/.env.example (VITE_*). The API host
# is expected to be separate from the static frontend host in production
# (proposed api.flowstead.darizae.dev / flowstead.darizae.dev — NOT assigned).

# --- Servers (loopback-only local defaults; secret in production) ---
DATABASE_URL=postgresql://flowstead:flowstead_local@127.0.0.1:54329/flowstead
POSTGRES_DB=flowstead
POSTGRES_USER=flowstead
POSTGRES_PASSWORD=flowstead_local
POSTGRES_PORT=54329

# --- Auth (server-only; default-deny: missing values fail private routes closed) ---
FLOWSTEAD_AUTH_MODE=supabase
SUPABASE_AUTH_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
SUPABASE_AUTH_VERIFICATION_MODE=jwks
# Browser-only publishable key (identity only); required only for
# legacy-auth-endpoint mode. Server secret keys never belong here.
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- NATS / JetStream (local loopback) ---
NATS_URL=nats://127.0.0.1:42229
NATS_PORT=42229
NATS_MONITOR_PORT=8229

# --- HTTP policy (default-deny: exact HTTPS or loopback-HTTP origins only) ---
FLOWSTEAD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FLOWSTEAD_TRUSTED_PROXIES=
FLOWSTEAD_RATE_LIMIT_REQUESTS=600
FLOWSTEAD_RATE_LIMIT_WINDOW_SECONDS=60
FLOWSTEAD_RATE_LIMIT_MAX_CLIENTS=4096
FLOWSTEAD_MAX_REQUEST_BODY_BYTES=16384
FLOWSTEAD_MAX_REQUEST_TARGET_BYTES=8192
# Per-principal+Plant bound on forecast-request submission (SEC19-03); keeps an
# authenticated operator from amplifying DB/outbox/JetStream work per Plant.
FLOWSTEAD_FORECAST_RATE_LIMIT_REQUESTS=30
FLOWSTEAD_FORECAST_RATE_LIMIT_WINDOW_SECONDS=60
