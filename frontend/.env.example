# Public / publishable frontend configuration only.
# NEVER put Supabase secret/service-role keys, SQL URIs, admin tokens or other
# private credentials here — these values ship to the browser.

# API endpoint for this build.
#  - dev / same-origin: leave VITE_API_BASE_PATH=/api/v1 (Vite proxies /api).
#  - host-separated production: set VITE_API_URL to the absolute HTTPS API base,
#    https://api.flowstead.darizae.dev/api/v1 (DNS record assigned; live TLS/API pending).
# VITE_API_URL takes precedence over VITE_API_BASE_PATH.
# VITE_API_URL=https://api.flowstead.darizae.dev/api/v1
VITE_API_BASE_PATH=/api/v1

# Supabase Auth client configuration (identity only; data always comes from
# FastAPI). Use the project URL and the anon/publishable key, never a secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=