# Flowstead migration/import-only secret template — NEVER pass to Docker Compose.
# Copy to an owner-controlled local/offline path outside Git with chmod 600;
# do not mount or install this file on a public-facing API/worker host.
# Only load this connection into a one-shot Alembic + validated M1 import
# process after reviewing the target database, schema, and backup boundary.
# Use the owner/migration Postgres role; it must NEVER be an API runtime secret.
MIGRATION_DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=verify-full
