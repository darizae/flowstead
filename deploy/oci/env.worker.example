# Optional Docker worker-only env_file template. root-owned mode 0600/0640.
# Must contain only the restricted flowstead_worker database connection and
# a separate private broker token; never share this with the API container.
NATS_URL=nats://REPLACE_WITH_SEPARATE_BROKER_TOKEN@nats:4222
DATABASE_URL=postgresql://flowstead_worker.YOUR_PROJECT_REF:REPLACE_WITH_SECURE_PASSWORD@YOUR_VERIFIED_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/etc/flowstead/supabase-root-2021.crt&connect_timeout=5
