[Unit]
Description=Flowstead synthetic demo outbox dispatcher and forecast worker
After=network-online.target flowstead-nats.service
Wants=network-online.target
Requires=flowstead-nats.service
[Service]
Type=simple
User=flowstead
Group=flowstead
Environment=PYTHONPATH=/opt/flowstead/current:/opt/flowstead/current/backend/src
Environment=NATS_URL=nats://127.0.0.1:4222
EnvironmentFile=/etc/flowstead/runtime.env
WorkingDirectory=/opt/flowstead/current
ExecStart=/opt/flowstead/venv/bin/python -m flowstead_api.messaging run
Restart=on-failure
RestartSec=5
TimeoutStopSec=130
MemoryMax=200M
MemorySwapMax=240M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
