# Worker-only environment. Never place an API, migration, or admin credential here.
# Copy to /etc/flowstead/worker.env; owner root, group flowstead, mode 0640.
# This role can process queues and write forecast results but cannot mutate
# Plants, source telemetry, ingest batches, or operator access assignments.
DATABASE_URL=postgresql://flowstead_worker.YOUR_PROJECT_REF:REPLACE_WITH_SECURE_PASSWORD@YOUR_VERIFIED_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/etc/flowstead/supabase-root-2021.crt&connect_timeout=5
