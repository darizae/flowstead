# Flowstead limited-privilege runtime environment on the existing OCI VM.
# Copy to /etc/flowstead/runtime.env (root:flowstead 0640) after securely
# provisioning an app-only LOGIN role; NEVER store a migration/admin password
# here, in Git, in a Docker env_file, or in Vercel's browser variables.
#
# The supplied runtime role is currently NOLOGIN until a secure password
# provisioning route is established. Do not set an invented/shared secret.
DATABASE_URL=postgresql://flowstead_runtime.YOUR_REF:REPLACE_WITH_SECRET@YOUR_VERIFIED_SUPABASE_POOLER_HOST:5432/postgres?sslmode=verify-full
FLOWSTEAD_AUTH_MODE=supabase
SUPABASE_AUTH_URL=https://YOUR_REF.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=https://YOUR_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
SUPABASE_AUTH_VERIFICATION_MODE=jwks
FLOWSTEAD_CORS_ORIGINS=https://YOUR_VERIFIED_FRONTEND_HOSTNAME
FLOWSTEAD_TRUSTED_PROXIES=127.0.0.1/32
FLOWSTEAD_RATE_LIMIT_REQUESTS=600
FLOWSTEAD_RATE_LIMIT_WINDOW_SECONDS=60
FLOWSTEAD_FORECAST_RATE_LIMIT_REQUESTS=30
FLOWSTEAD_FORECAST_RATE_LIMIT_WINDOW_SECONDS=60
