# Optional Docker API-only env_file template. Runtime secret outside Git.
# root-owned mode 0600 or 0640. Do not use worker or migration credentials.
DATABASE_URL=postgresql://flowstead_api.hkyobferqdfiicnsaupl:REPLACE_WITH_SECURE_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/flowstead/supabase-root-2021.crt&connect_timeout=5
FLOWSTEAD_AUTH_MODE=supabase
SUPABASE_AUTH_URL=https://hkyobferqdfiicnsaupl.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=https://hkyobferqdfiicnsaupl.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256
SUPABASE_AUTH_VERIFICATION_MODE=jwks
FLOWSTEAD_CORS_ORIGINS=https://flowstead.darizae.dev
# Empty by default: do NOT trust the full Docker bridge without an observed
# exact Caddy proxy IP/CIDR. Rate limits are coarser until deliberately set.
FLOWSTEAD_TRUSTED_PROXIES=
FLOWSTEAD_RATE_LIMIT_REQUESTS=180
FLOWSTEAD_FORECAST_RATE_LIMIT_REQUESTS=10
FLOWSTEAD_FORECAST_RATE_LIMIT_WINDOW_SECONDS=60
