# Flowstead public-demo hosted runtime configuration (T-016).
# This is a TEMPLATE: copy it to a host secret-file OUTSIDE Git (e.g.
# /etc/flowstead/hosted.env, chmod 600, root-only) and fill the values there.
# The same file is referenced by compose.hosted.yml via HOSTED_ENV_FILE.
# Never commit the populated file or any real secret.

# --- Server-only PostgreSQL (Supabase flowstead-demo) ---
# Direct (IPv6) or IPv4 session-pooler endpoint for the existing demo project
# hkyobferqdfiicnsaupl. TLS verification required (sslmode=verify-full with the
# issuer). Never a service-role key; the app connects as the database owner used
# by the Alembic/import step and reads/writes only the app schema.
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Auth (server-only; default-deny: missing values fail private routes closed) ---
FLOWSTEAD_AUTH_MODE=supabase
SUPABASE_AUTH_URL=https://YOUR_REF.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=https://YOUR_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
SUPABASE_AUTH_VERIFICATION_MODE=jwks

# --- NATS / JetStream (internal network only) ---
# Set by compose.hosted.yml (nats://nats:4222); do not override here.

# --- HTTP policy (default-deny: exact HTTPS origins only) ---
# Exact approved frontend origin(s), comma-separated, HTTPS only.
FLOWSTEAD_CORS_ORIGINS=https://flowstead.darizae.dev
# CIDR of the Docker bridge the reverse proxy sits on, so the app trusts only
# the proxy for client IP. Confirm with: docker network inspect flowstead-demo_default
FLOWSTEAD_TRUSTED_PROXIES=172.18.0.0/16
FLOWSTEAD_RATE_LIMIT_REQUESTS=600
FLOWSTEAD_RATE_LIMIT_WINDOW_SECONDS=60
FLOWSTEAD_RATE_LIMIT_MAX_CLIENTS=4096
FLOWSTEAD_MAX_REQUEST_BODY_BYTES=16384
FLOWSTEAD_MAX_REQUEST_TARGET_BYTES=8192